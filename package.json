{
  "name": "daily-news-app",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/prepare-data.js",
    "process-candidate": "node scripts/process-candidate.js",
    "process-theme": "node scripts/process-theme.js",
    "activate-theme": "node scripts/activate-theme.js",
    "list-themes": "node scripts/list-themes.js",
    "switch-theme": "node scripts/switch-theme.js",
    "rollback-theme": "node scripts/rollback-theme.js",
    "build": "node scripts/prepare-data.js && node scripts/build.js",
    "start": "node scripts/prepare-data.js && node scripts/serve.js",
    "mcp-probe:inspect": "mcp-inspector",
    "mcp-probe:start": "node test-support/mcp-probe/server.js",
    "mcp-probe:test": "node --test test/mcp-probe.test.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.3.0"
  }
}
