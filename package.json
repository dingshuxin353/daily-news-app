{
  "name": "daily-news-app",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/prepare-data.js",
    "process-candidate": "node scripts/process-candidate.js",
    "process-todo": "node scripts/process-todo.js",
    "migrate-v0.9": "node scripts/migrate-v0.9.js",
    "migrate-v0.10": "node scripts/migrate-v0.10.js",
    "process-theme": "node scripts/process-theme.js",
    "activate-theme": "node scripts/activate-theme.js",
    "list-themes": "node scripts/list-themes.js",
    "switch-theme": "node scripts/switch-theme.js",
    "inherit-theme": "node scripts/inherit-theme.js",
    "rollback-theme": "node scripts/rollback-theme.js",
    "build": "node scripts/prepare-data.js && node scripts/build.js",
    "start": "node scripts/prepare-data.js && node scripts/build.js && node scripts/serve.js",
    "test": "node --test test/*.test.js",
    "build:cloud": "tsc -p tsconfig.cloud.json",
    "start:cloud": "node .cloud-dist/src/cloud/server.js",
    "db:migrate": "npm run build:cloud --silent && node .cloud-dist/src/cloud/migrate.js",
    "test:cloud": "npm run build:cloud --silent && node --test test/cloud/unit.cloud.js",
    "test:cloud:integration": "npm run build:cloud --silent && node --test --test-concurrency=1 test/cloud/*.integration.cloud.js",
    "test:m3e:live": "node test/m3-e/run-live-mcp.js",
    "test:m3e:record-schedule": "node test/m3-e/record-schedule.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/server": "2.0.0",
    "better-auth": "1.7.1",
    "hono": "4.13.4",
    "pg": "8.23.0",
    "tencentcloud-sdk-nodejs-ses": "4.1.271",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
