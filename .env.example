# M2 cloud runtime example. Copy values into an untracked environment file
# or inject them through the process manager. These placeholders are invalid
# for production and contain no real credentials.
CLOUD_ORIGIN=https://dailynews.invalid
CLOUD_BASE_PATH=
CLOUD_HOST=127.0.0.1
CLOUD_PORT=3000
DATABASE_URL=postgresql://dailynews:replace-me@127.0.0.1:5432/dailynews
PG_SSL_MODE=disable
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# PostgreSQL integration tests require a dedicated disposable database whose
# name contains "test" or "ci". Never point this at probe or user databases.
TEST_DATABASE_URL=postgresql://dailynews_test:replace-me@127.0.0.1:5432/dailynews_test
