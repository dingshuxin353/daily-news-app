# v1 cloud runtime example through M3-A. Copy values into an untracked environment file
# or inject them through the process manager. These placeholders are invalid
# for production and contain no real credentials.
CLOUD_ORIGIN=https://dailynews.invalid
CLOUD_BASE_PATH=
CLOUD_HOST=127.0.0.1
CLOUD_PORT=3000
DATABASE_URL=postgresql://dailynews:replace-me@127.0.0.1:5432/dailynews
PG_SSL_MODE=disable
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
IDENTITY_DIGEST_SECRET=replace-with-at-least-32-random-characters
AGENT_TOKEN_DIGEST_SECRET=replace-with-a-different-32-character-secret
PAIRING_CODE_DIGEST_SECRET=replace-with-another-32-character-secret
AGENT_API_BASE_URL=https://dailynews.invalid/api/v1
AGENT_MCP_URL=https://dailynews.invalid/mcp
MAIL_MODE=fake

# Required only when MAIL_MODE=ses. Keep every real value outside Git.
TENCENTCLOUD_SECRET_ID=replace-me
TENCENTCLOUD_SECRET_KEY=replace-me
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM_EMAIL=verified-sender@dailynews.invalid
TENCENT_SES_TEMPLATE_ID=0
TENCENT_SES_SUBJECT=DailyNews 登录验证码

# PostgreSQL integration tests require a dedicated disposable database whose
# name contains "test" or "ci". Never point this at probe or user databases.
TEST_DATABASE_URL=postgresql://dailynews_test:replace-me@127.0.0.1:5432/dailynews_test
